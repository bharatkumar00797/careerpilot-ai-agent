# LLM provider: mock (default, offline, deterministic) | openai | groq | ollama
CAREERPILOT_PROVIDER=mock
CAREERPILOT_BASE_URL=https://api.openai.com/v1
CAREERPILOT_API_KEY=
CAREERPILOT_MODEL=gpt-4o-mini
CAREERPILOT_TIMEOUT=60

# --- HTTP service (careerpilot serve) ---
# Comma-separated API keys; when set every /api call needs X-API-Key or Authorization: Bearer
CAREERPILOT_API_KEYS=
# Dev mode: no auth, full access (localhost only). With no keys and no dev mode the service
# runs as a public demo (packaged profiles/jobs + mock provider only).
CAREERPILOT_DEV_MODE=false
CAREERPILOT_CORS_ORIGINS=
CAREERPILOT_RATE_LIMIT_PER_MINUTE=120
CAREERPILOT_ANALYZE_LIMIT_PER_MINUTE=10
CAREERPILOT_MAX_CONCURRENT_RUNS=2
CAREERPILOT_MAX_QUEUED_RUNS=8
CAREERPILOT_MAX_ANALYSES_KEPT=200
# Only enable behind a reverse proxy you control (uses the right-most X-Forwarded-For hop)
CAREERPILOT_TRUST_PROXY=false
# Run analyses inside the request (auto-on for Vercel / AWS Lambda)
CAREERPILOT_SYNC_RUNS=false
# Host port published by docker compose (container still listens on 8000)
CAREERPILOT_HOST_PORT=8000
